#!/usr/bin/env zsh
# herdr-soul — one tool, five verbs: put an oracle's soul to work inside another repo.
#   herdr-soul list                      oracles that can come in (soul, Discord token, Claude token, machine, where they already are)
#   herdr-soul ls    [repo]              souls living in a repo: worktree, thread, pane, gateway ready?
#   herdr-soul check <oracle> [repo]     preflight only, changes nothing; prints the fix for every failed item
#   herdr-soul in    <oracle> [repo]     check, then soul-in-repo.sh (channel, thread, worktree, space, Laris row, hello)
#                                        --migrate / --deny-main / --chname=dash / --channel=<id> are passed through to soul-in-repo.sh
#   herdr-soul room  <repo> <oracle>...  layout 9 for many souls at once: per oracle, --migrate if it already has a body
#                                        in <repo>, else in; always --deny-main. Plan by default; --yes runs (Nat's go).
#                                        --channel=<id> reuses an existing room (e.g. #💧・nongbua). Prints what it leaves undone.
#   herdr-soul link  <wt-path> [--bot=<oracle>] [--channel=<id>] [--name=<thread>] [--pane=<bot body pane>]
#                                        connect a manual worktree to an EXISTING bot body by forward (no second gateway):
#                                        the bot opens thread <name>, its access gets {forwardTo: <wt>, answerCmd}, claude
#                                        starts in <wt> beside the bot body without Discord env. Plan by default; --yes runs.
#   herdr-soul unlink <wt-path> [--bot=<oracle>]   archive that thread and drop the forward row (backup). Plan; --yes runs.
#   herdr-soul out   <oracle> [repo]     plan to take a soul out; --go closes its pane, drops it from the thread's souls[],
#                                        archives the thread only when no soul is left
# Laris rows, newest first. layout 9 (2026-11-07 06:34Z): one row per repo CHANNEL (<owner>∕<repo>), "layout": 9,
# souls[] + threads{oracle: thread}. #repo layout (morning of 2026-11-07): one row per #repo thread, souls[]. Old rows
# ('<oracle> soul in <repo>') still count until the body is migrated. Notes starting 'moved to' are history, never live.
# [repo] = owner/name, an absolute path, or empty = the git repo of the current directory.
# Every verb accepts --dry. Tokens come from pass and are never printed.
set -euo pipefail
HERE=${0:A:h}
TEAM=${HERDR_SOUL_TEAM:-/opt/Code/github.com/laris-co/laris-team}
LARIS=${HERDR_SOUL_LARIS:-$HOME/.claude/channels/laris-labs-oracle/access.local.json}   # override for tests
GHQ=$(ghq root)
SCRIPT=${HERDR_SOUL_SCRIPT:-$HERE/../soul-in-repo.sh}
DRY=0; GO=0; YES=0; ARGS=(); PASS=(); BOT=somsri-oracle; NAME=""; BPANE=""   # PASS = flags handed to soul-in-repo.sh by `in`
for a in "$@"; do case $a in --dry) DRY=1;; --go) GO=1;; --yes) YES=1;; --bot=*) BOT=${${a#*=}%-oracle}-oracle;; --name=*) NAME=${a#*=};; --pane=*) BPANE=${a#*=};; --migrate|--deny-main|--chname=*|--channel=*) PASS+=$a;; *) ARGS+=$a;; esac; done
VERB=${ARGS[1]:-ls}

repo_path() {  # $1 = owner/name | abs path | empty
  local r=${1:-}
  if [[ -z $r ]]; then git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | xargs dirname 2>/dev/null || { echo "not in a git repo; pass a repo" >&2; exit 2; }
  elif [[ $r = /* ]]; then echo $r
  else echo $GHQ/github.com/$r; fi
}
cfg() { sed -n "s/^$2: *\\([^ #]*\\).*/\\1/p" $TEAM/oracles/$1/config.yaml 2>/dev/null | head -1; }
has_pass() { pass show "$1" >/dev/null 2>&1; }
repo_full() {  # $1 = repo path -> <owner>/<repo> (origin, else the ghq path), same rule as soul-in-repo.sh
  local f=$(git -C $1 remote get-url origin 2>/dev/null | sed -E 's#^(git@[^:]+:|[a-z+]+://[^/]+/)##; s#\.git$##')
  [[ $f = */* ]] || f=${1#$GHQ/github.com/}
  echo $f
}
rows() {  # Laris soul rows, one line per soul: <thread> <layout l9|repo|old> <oracle> <repo>   (history rows skipped)
  python3 - "$LARIS" <<'PY'
import json,re,sys
try: g=json.load(open(sys.argv[1])).get("groups",{})
except Exception: g={}
for th,v in g.items():
    note=v.get("note","")
    if note.startswith("moved to"): continue
    if v.get("layout")==9:
        for o in v.get("souls",[]): print(v.get("threads",{}).get(o,"-"),"l9",o,v.get("repo","?"))
        continue
    if "souls" in v:
        m=re.match(r"repo thread (\S+?):",note); repo=v.get("repo") or (m.group(1) if m else "?")
        for o in v["souls"]: print(th,"repo",o,repo)
        continue
    m=re.match(r"(\S+?)(?:-oracle)? soul in (\S+)",note)
    if m: print(th,"old",m.group(1).lower().removesuffix("-oracle")+"-oracle",m.group(2))
PY
}
soul_dir() {  # the oracle's soul repo: config.yaml soul: ({ghq} expanded), else laris-co/<oracle>
  local s=$(sed -n 's/^soul: *"\{0,1\}\([^"#]*\)"\{0,1\}.*/\1/p' $TEAM/oracles/$1/config.yaml 2>/dev/null | head -1 | sed "s#{ghq}#$GHQ#")
  echo ${s:-$GHQ/github.com/laris-co/$1}
}

case $VERB in
list)
  printf "%-32s %-5s %-6s %-7s %-8s %s\n" ORACLE SOUL TOKEN CLAUDE MACHINE "ALREADY IN (Laris rows)"
  where_all=$(rows)
  for d in $TEAM/oracles/*-oracle(/); do
    o=${d:t}; short=${o%-oracle}
    [[ $(cfg $o retired) = true ]] && continue
    soul=$([[ -f $(soul_dir $o)/CLAUDE.md ]] && echo ✓ || echo ✗)
    tok=$(has_pass discord/$o-token && echo ✓ || echo ✗)
    ct=$(cfg $o claude_token); ct=${ct:-t3}
    m=$(cfg $o machine); m=${m:--}
    where=$(print -r -- $where_all | awk -v k=$o '$3==k{printf "%s%s%s", sep, $4, ($2=="old"?" (old layout)":($2=="repo"?" (#repo layout)":"")); sep=", "}')
    printf "%-32s %-5s %-6s %-7s %-8s %s\n" $o $soul $tok $ct $m "${where:--}"
  done
  ;;

ls)
  R=$(repo_path ${ARGS[2]:-}); full=$(repo_full $R); echo "repo: $R ($full)"
  where_all=$(rows)
  found=0
  git -C $R worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r W; do
    [[ $W = */wt/*-soul ]] || continue; found=1
    o=${${W:t}%-soul}
    # every room row of the soul (Laris 2026-11-07: ls showed only the first row, the old #repo thread).
    # The soul's own layout-9 thread goes first; a #repo row is a leftover once a layout-9 row exists.
    th=$(python3 - $W/.discord/access.json "$LARIS" $o <<'PY3' 2>/dev/null || echo -
import json,sys
a,lf,o=sys.argv[1:]
g=json.load(open(a)).get("groups",{})
try: L=json.load(open(lf)).get("groups",{})
except Exception: L={}
l9={v.get("threads",{}).get(o) for v in L.values() if v.get("layout")==9}
repo={k for k,v in L.items() if "souls" in v and v.get("layout")!=9}
old={k for k,v in L.items() if " soul in " in v.get("note","") and not v.get("note","").startswith("moved to")}
def kind(k,v):
    n=v.get("note","")
    if v.get("deny"): return 3,"deny"
    if k in l9 or n.startswith("layout 9"): return 0,"layout 9"
    if n.startswith("office"): return 1,"office"
    if k in repo: return 2,"#repo"
    if k in old: return 2,"old layout"
    return 2,""
rows=sorted(((*kind(k,v),k,v) for k,v in g.items()),key=lambda r:r[0])
has9=any(r[0]==0 for r in rows)
out=[]
for _,lab,k,v in rows:
    if lab=="#repo" and has9: lab="#repo leftover"
    ears="tag" if v.get("requireMention") else "all"
    out.append(f"{k} ({lab+', ' if lab else ''}{ears})")
print(out[0]+("  also: "+", ".join(out[1:]) if out[1:] else "") if out else "-")
PY3
)
    ready=$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print("ready" if d.get("gateway",{}).get("ready") else "not ready")' $W/.discord/status.json 2>/dev/null || echo "no status")
    pane=$(herdr pane list 2>/dev/null | python3 -c 'import json,sys
w=sys.argv[1]
try:
  ps=json.load(sys.stdin)["result"]["panes"]
  print(next((p["pane_id"] for p in ps if (p.get("foreground_cwd") or p.get("cwd"))==w),"-"))
except Exception: print("-")' $W)
    echo "  $o  pane $pane  gateway $ready  ($W)"
    echo "      thread $th"
  done
  python3 - "$LARIS" "$full" <<'PY2'
import json,sys
f,r=sys.argv[1:]
try: g=json.load(open(f)).get("groups",{})
except Exception: g={}
import re
def repo_of(v):
    m=re.match(r"repo thread (\S+?):",v.get("note",""))
    return v.get("repo") or (m.group(1) if m else "")
out=[]
for k,v in g.items():
    if repo_of(v)!=r or v.get("note","").startswith("moved to"): continue
    if v.get("layout")==9: out.append(f"  Laris: channel {v.get('channel','?')} ({k}, layout 9) souls: "+", ".join(f"{o} › {v.get('threads',{}).get(o,'-')}" for o in v.get("souls",[])))
    elif "souls" in v: out.append(f"  Laris: #repo › {r} ({k}) souls: "+", ".join(v["souls"]))
print("\n".join(out) or f"  Laris: no row for {r} yet")
PY2
  ;;

check)
  o=${ARGS[2]:?oracle}; R=$(repo_path ${ARGS[3]:-}); fail=0
  ok()  { echo "  ✓ $1"; }
  bad() { echo "  ✗ $1"; echo "      fix: $2"; fail=1; }
  echo "check $o -> $R"
  sd=$(soul_dir $o); [[ -f $sd/CLAUDE.md ]] && ok "soul ${sd#$GHQ/github.com/}/CLAUDE.md" || bad "no soul at $sd" "ghq get the soul repo named in oracles/$o/config.yaml soul:"
  has_pass discord/$o-token && ok "Discord token in pass" || bad "no pass discord/$o-token" "create the bot, then pass insert discord/$o-token (terminal)"
  ct=$(cfg $o claude_token); ct=${ct:-t3}
  has_pass claude/token-$ct && ok "Claude token $ct" || bad "no pass claude/token-$ct" "set claude_token: in oracles/$o/config.yaml or add the pass entry"
  [[ -d $R/.git || -f $R/.git ]] && ok "repo exists" || bad "not a repo: $R" "ghq get <owner>/<name>"
  if [[ -d $R ]]; then
    git -C $R check-ignore -q wt/ && ok "wt/ is ignored" || bad "wt/ is not ignored" "echo wt/ >> $R/.gitignore && git -C $R commit -m 'ignore wt/' .gitignore"
    W=$R/wt/$o-soul
    [[ -d $W ]] && echo "  • worktree already there: $W (in will reuse it)" || ok "no worktree yet"
  fi
  name=${R:t}; full=$(repo_full $R); where_all=$(rows)
  l9=$(print -r -- $where_all | awk -v r=$full '$2=="l9" && $4==r{print $3}' | paste -sd, -)
  if print -r -- $where_all | awk -v r=$full -v o=$o '$2=="l9" && $4==r && $3==o{f=1} END{exit !f}'; then
    bad "$o is already a soul of $full (layout 9)" "nothing to do; to rebuild its body: zsh $SCRIPT $o $full --migrate --dry"
  elif print -r -- $where_all | awk -v r=$full -v n=$name -v o=$o '$3==o && (($2=="repo" && $4==r) || ($2=="old" && $4==n)){f=1} END{exit !f}'; then
    bad "$o still lives in an older layout for $full (#repo or #$o thread)" "zsh $SCRIPT $o $full --migrate --dry"
  elif [[ -n $l9 ]]; then
    echo "  • repo channel exists (layout 9, souls: $l9): in adds thread '$o' to it"
  else ok "no layout-9 channel for $full yet (in will open it)"; fi
  m=$(cfg $o machine)
  [[ -n $m ]] && echo "  • main body lives on $m: a new thread is in no other access file, so no double answers"
  (( fail )) && { echo "result: NOT ready"; exit 1; } || echo "result: ready"
  ;;

in)
  o=${ARGS[2]:?oracle}; R=$(repo_path ${ARGS[3]:-})
  # --migrate rebuilds a body that is already in, so the "not in yet" preflight does not apply to it
  if [[ ${PASS[(I)--migrate]} == 0 ]]; then $0 check $o $R || { echo "stop: fix the items above first"; exit 1; }; fi
  export HERDR_SOUL_DIR=$(soul_dir $o)
  if (( DRY )); then zsh $SCRIPT $o $R $PASS --dry; else zsh $SCRIPT $o $R $PASS; fi
  ;;

room)
  # Nat 2026-11-07 11:15Z (via Laris): "make cli ... then run" layout 9 on many souls at once.
  R=$(repo_path ${ARGS[2]:?"repo: herdr-soul room <repo> <oracle>... [--channel=<id>] [--yes]"}); full=$(repo_full $R)
  (( ${#ARGS} >= 3 )) || { echo "which oracles?  herdr-soul room $full neo-oracle pulse-oracle --dry"; exit 2; }
  run=$(( YES && !DRY ))
  pin=${PASS[(r)--channel=*]:-}
  (( run )) && how=RUN || how="plan only"
  echo "room: $full ($R) · ${pin:-channel found by name <owner>∕<repo>} · $how"
  export HERDR_SOUL_DIR
  ok=(); failed=()
  for o in ${ARGS[3,-1]}; do
    o=${o%-oracle}-oracle; W=$R/wt/$o-soul
    if [[ -f $W/.discord/access.json ]]; then mode=migrate; fl=(--migrate); else mode=in; fl=(); fi
    echo; echo "── $o: $mode (--deny-main${pin:+ $pin})"
    if [[ $mode = in ]] && ! $0 check $o $R; then failed+="$o (check failed)"; continue; fi
    HERDR_SOUL_DIR=$(soul_dir $o)
    if (( run )); then zsh $SCRIPT $o $R $fl --deny-main ${pin:+$pin}; else zsh $SCRIPT $o $R $fl --deny-main ${pin:+$pin} --dry; fi \
      && ok+="$o ($mode)" || failed+="$o ($mode exited $?)"
  done
  echo; echo "room summary: ${#ok} ok${ok:+: ${(j:, :)ok}} · ${#failed} failed${failed:+: ${(j:, :)failed}}"
  echo "not done by room (do these by hand, each on Nat's terminal go):"
  echo "  • office thread: the Somsri bot opens 'office' in the channel; rows for it in somsri-oracle/.discord (all) and in each soul (tag)"
  echo "  • main bodies on other machines: --deny-main only prints their herdr --machine prompt; send it to that box's agent"
  echo "  • old rooms: archive the leftover #repo / per-oracle threads once the souls hear their new threads"
  (( run )) || echo "plan only. To run (Nat's go, from a terminal): herdr-soul room $full ${ARGS[3,-1]}${pin:+ $pin} --yes"
  (( ${#failed} == 0 ))
  ;;

link|unlink)
  # Nat 2026-11-07 (Discord repo-soul, via Laris): "can this make maw cli?" A manual herdr worktree joins an existing bot
  # body by FORWARD: the bot body's gateway hears the thread and prompts the worktree's agent (plugin forwardToWorktree);
  # the worktree answers with discord-say.sh (REST only). One bot = one gateway, so no double answers.
  W=${ARGS[2]:?"worktree: herdr-soul $VERB <wt-path> [--bot=<oracle>] [--yes]"}; W=${W:A}
  [[ -d $W ]] || { echo "no folder $W"; exit 1; }
  run=$(( YES && !DRY ))
  SAY=$TEAM/tools/discord-say.sh
  if [[ $BOT = somsri-oracle ]]; then ACC=$GHQ/github.com/laris-co/somsri-oracle/.discord/access.json
  else ACC=$HOME/.claude/channels/$BOT/access.local.json; fi
  pass show discord/$BOT-token >/dev/null 2>&1 || { echo "no pass discord/$BOT-token"; exit 1; }
  [[ -f $ACC ]] || { echo "no access file for $BOT at $ACC (is its body set up?)"; exit 1; }
  existing=$(python3 -c 'import json,sys
g=json.load(open(sys.argv[1])).get("groups",{})
print(next((k for k,v in g.items() if v.get("forwardTo")==sys.argv[2]),""))' $ACC $W)
  if [[ $VERB = unlink ]]; then
    [[ -n $existing ]] || { echo "no forward row for $W in $ACC: nothing to unlink"; exit 1; }
    echo "plan: unlink $W from $BOT"
    echo "  1. archive thread $existing (as $BOT; Nothing is Deleted: it stays readable)"
    echo "  2. back up $ACC, then drop groups[$existing] (forwardTo $W)"
    echo "  3. the agent pane in $W stays open: close it yourself when its work is pushed"
    (( run )) || { echo "plan only. To run (Nat's go): herdr-soul unlink $W --bot=$BOT --yes"; exit 0; }
    T=$(pass show discord/$BOT-token | head -1 | tr -d '[:space:]')
    code=$(curl -sS -o /dev/null -w '%{http_code}' -X PATCH -H "Authorization: Bot $T" -H 'Content-Type: application/json' \
      -d '{"archived":true}' https://discord.com/api/v10/channels/$existing)
    echo "  ✓ thread archive: HTTP $code"
    cp -p $ACC $ACC.bak-$(date +%Y%m%d-%H%M%S)-unlink
    python3 -c 'import json,sys
f,k=sys.argv[1:]; a=json.load(open(f)); a["groups"].pop(k,None); json.dump(a,open(f,"w"),indent=2,ensure_ascii=False)' $ACC $existing
    echo "  ✓ row $existing dropped (backup beside $ACC)"
    exit 0
  fi
  [[ -z $existing ]] || { echo "already linked: $W -> thread $existing in $ACC (unlink first)"; exit 1; }
  git -C $W rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "$W is not a git worktree"; exit 1; }
  NAME=${NAME:-${W:t}}
  pin=${PASS[(r)--channel=*]:-}; CH=${pin#--channel=}
  if [[ -z $CH ]]; then  # the layout-9 channel of the worktree's repo, from Laris's rows
    full=$(repo_full $(git -C $W rev-parse --path-format=absolute --git-common-dir | xargs dirname))
    CH=$(python3 -c 'import json,sys
try: g=json.load(open(sys.argv[1])).get("groups",{})
except Exception: g={}
print(next((k for k,v in g.items() if v.get("layout")==9 and v.get("repo")==sys.argv[2]),""))' $LARIS $full)
    [[ -n $CH ]] || { echo "no layout-9 channel for $full in Laris rows: pass --channel=<id>"; exit 1; }
  fi
  if [[ -z $BPANE ]]; then  # the bot body's pane: the agent whose cwd is the bot's home
    home=$([[ $BOT = somsri-oracle ]] && echo $GHQ/github.com/laris-co/somsri-oracle || soul_dir $BOT)
    BPANE=$(herdr agent list 2>/dev/null | python3 -c 'import json,sys
h=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]
print(next((x["pane_id"] for x in a if x.get("cwd")==h and x.get("agent")=="claude"),""))' $home)
    [[ -n $BPANE ]] || { echo "no live $BOT body pane (cwd $home): pass --pane=<id>"; exit 1; }
  fi
  ANS="BOT=$BOT $SAY"
  echo "plan: link $W -> $BOT by forward (no second gateway)"
  echo "  1. as $BOT: post '🔗 $NAME' in channel $CH, open thread '$NAME' on it ($SAY --thread)"
  echo "  2. back up $ACC, add groups[<thread>] = {requireMention: false, forwardTo: $W,"
  echo "       answerCmd: \"$ANS\", allowFrom: [Nat, catbutter]}"
  echo "  3. split $BPANE ($BOT body), start claude in $W with env -u DISCORD_BOT_TOKEN -u DISCORD_STATE_DIR"
  echo "  4. test: Nat types a line in the thread; the $BOT body forwards it to that pane, which answers with answerCmd"
  (( run )) || { echo "plan only. To run (Nat's go): herdr-soul link $W --bot=$BOT${pin:+ $pin}${NAME:+ --name=$NAME} --yes"; exit 0; }
  mid=$(BOT=$BOT $SAY $CH "🔗 $NAME: worktree ${W/#$HOME/~} joins through $BOT (forward, no second gateway)" | sed -n 's/^sent (id: \([0-9]*\))$/\1/p')
  [[ -n $mid ]] || { echo "stop: could not post in $CH as $BOT"; exit 1; }
  TH=$(BOT=$BOT $SAY --thread $CH $mid "$NAME" | sed -n 's/^thread (id: \([0-9]*\))$/\1/p')
  [[ -n $TH ]] || { echo "stop: could not open thread on $mid (message stays; nothing else changed)"; exit 1; }
  echo "  ✓ thread '$NAME' $TH"
  cp -p $ACC $ACC.bak-$(date +%Y%m%d-%H%M%S)-link
  python3 -c 'import json,sys
f,th,w,ans,n=sys.argv[1:]; a=json.load(open(f)); a.setdefault("groups",{})[th]={"requireMention":False,"forwardTo":w,"answerCmd":ans,
 "allowFrom":["691531480689541170","917019242094817301"],"note":"link: thread %s forwards to worktree %s (herdr-soul link)" % (n,w)}
json.dump(a,open(f,"w"),indent=2,ensure_ascii=False)' $ACC $TH $W $ANS $NAME
  echo "  ✓ row $TH in $ACC (backup beside it)"
  NP=$(herdr pane split $BPANE --direction down | python3 -c 'import json,sys;print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')
  herdr pane run $NP "cd ${(q)W} && env -u DISCORD_BOT_TOKEN -u DISCORD_STATE_DIR claude --dangerously-skip-permissions" >/dev/null
  echo "  ✓ claude starting in $NP ($W)"
  echo "test: type one line in thread $TH as Nat; expect a prompt in $NP and an answer signed by $BOT"
  echo "      check the row: python3 -m json.tool $ACC | rg -A3 $TH"
  ;;

out)
  o=${ARGS[2]:?oracle}; R=$(repo_path ${ARGS[3]:-}); W=$R/wt/$o-soul
  [[ -d $W ]] || { echo "no soul body at $W"; exit 1; }
  th=$(python3 -c 'import json,sys;print(next(iter(json.load(open(sys.argv[1])).get("groups",{})),""))' $W/.discord/access.json)
  pane=$(herdr pane list | python3 -c 'import json,sys;w=sys.argv[1];ps=json.load(sys.stdin)["result"]["panes"];print(next((p["pane_id"] for p in ps if (p.get("foreground_cwd") or p.get("cwd"))==w),""))' $W)
  dirty=$(git -C $W status --porcelain | wc -l | tr -d ' ')
  ahead=$(git -C $W rev-list --count @{u}..HEAD 2>/dev/null || git -C $W rev-list --count origin/main..HEAD 2>/dev/null || echo "?")
  # who else lives in this thread? (new layout: souls[]; old layout or no row: just this soul)
  # layout 9: the row is the repo CHANNEL's; this soul's own thread is always archived
  key=$(python3 -c 'import json,sys
f,t,o=sys.argv[1:]
try: g=json.load(open(f)).get("groups",{})
except Exception: g={}
print(next((k for k,v in g.items() if v.get("layout")==9 and v.get("threads",{}).get(o)==t),t))' $LARIS ${th:-x} $o)
  l9=$([[ $key != ${th:-x} ]] && echo 1 || echo 0)
  left=$(python3 -c 'import json,sys
f,t,o=sys.argv[1:]
try: r=json.load(open(f)).get("groups",{}).get(t)
except Exception: r=None
if r is None: print("norow")
elif "souls" in r: print(" ".join(s for s in r["souls"] if s!=o) or "none")
else: print("none")' $LARIS ${key:-x} $o)
  echo "plan: take $o out of ${R:t}"
  echo "  1. close pane ${pane:-none}"
  if [[ $left = norow ]]; then
    echo "  2. no Laris row for thread ${th:-?}: nothing to change there"
    echo "  3. thread ${th:-?} not archived (no row says who lives in it)"
  elif (( l9 )); then
    [[ $left = none ]] && echo "  2. remove Laris row for channel $key ($o was the last soul; backup first; the channel stays)" \
                       || echo "  2. drop $o from souls[] and threads{} of channel $key (backup first); stays: $left"
    echo "  3. archive thread ${th:-?} ($o's own thread; Nothing is Deleted: it stays readable)"
  elif [[ $left = none ]]; then
    echo "  2. remove Laris row for thread ${th:-?} ($o was the last soul; backup first)"
    echo "  3. archive thread ${th:-?} (Nothing is Deleted: it stays readable)"
  else
    echo "  2. drop $o from souls[] of thread ${th:-?} (backup first); stays: $left"
    echo "  3. thread ${th:-?} stays open (other souls live there)"
  fi
  echo "  4. worktree stays: $dirty uncommitted, $ahead unpushed — remove later with: git -C $R worktree remove $W"
  (( GO )) || { echo "(plan only; add --go to do 1-3)"; exit 0; }
  [[ -n $pane ]] && herdr pane close $pane >/dev/null && echo "  ✓ pane closed"
  if [[ -n $th && $left != norow ]]; then
    cp $LARIS $LARIS.bak-$(date +%Y%m%d-%H%M%S)-soul-out
    python3 -c 'import json,sys
f,t,o=sys.argv[1:]; a=json.load(open(f)); g=a.get("groups",{}); r=g.get(t,{})
rest=[s for s in r.get("souls",[]) if s!=o]
if rest and r.get("layout")==9:
    r["souls"]=rest; r.get("threads",{}).pop(o,None)
    r["note"]="repo channel %s (layout 9): souls %s each answer in their own thread; Laris hears every line, answers only when tagged" % (r.get("channel","?"), ", ".join(rest))
elif rest:
    r["souls"]=rest
    r["note"]=r.get("note","").split(": souls ")[0]+": souls "+", ".join(rest)+" answer with their own bots when tagged; Laris hears (own thread), silent unless tagged"
else: g.pop(t,None)
json.dump(a,open(f,"w"),indent=2)' $LARIS $key $o && echo "  ✓ Laris row updated ($o out)"
  fi
  if [[ -n $th ]] && { (( l9 )) || [[ $left = none ]]; }; then
    T=$(pass show discord/laris-labs-oracle-token | head -1 | tr -d '[:space:]')
    code=$(curl -sS -o /dev/null -w '%{http_code}' -X PATCH -H "Authorization: Bot $T" -H 'Content-Type: application/json' \
      -d '{"archived":true}' https://discord.com/api/v10/channels/$th)
    echo "  ✓ thread archive: HTTP $code"
  fi
  ;;

*) sed -n '2,12p' $0; exit 2;;
esac
