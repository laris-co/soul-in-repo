import json,os,sys,urllib.request
tok=dict(l.split(" ",1) for l in os.environ.get("SOULTOKENS","").splitlines() if " " in l)
by={}
for ln in sys.stdin:
    p=ln.split()
    if len(p)>=4: by.setdefault(p[0],[]).append((p[1],p[2],p[3].replace("-"," ")))
def get(t,o):
    k=tok.get(o)
    if not k: return None
    r=urllib.request.Request(f"https://discord.com/api/v10/channels/{t}",headers={"Authorization":"Bot "+k,"User-Agent":"herdr-soul (soul-in-repo, 1)"})
    try: return json.load(urllib.request.urlopen(r,timeout=10))
    except Exception as e: return {"_err":str(getattr(e,"code",e))}
for t,souls in by.items():
    info=None
    for o,_,_ in souls:
        info=get(t,o)
        if info and "_err" not in info: break
    if not info: name="?"; meta="no token to look"
    elif "_err" in info: name="?"; meta="GET "+info["_err"]
    else:
        name=info.get("name","?"); md=info.get("thread_metadata") or {}
