  key=$(python3 -c 'import json,sys
f,t,o=sys.argv[1:]
try: g=json.load(open(f)).get("groups",{})
except Exception: g={}
print(next((k for k,v in g.items() if v.get("layout")==9 and v.get("threads",{}).get(o)==t),t))' $LARIS ${th:-x} $o)
