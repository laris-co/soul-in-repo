    for t in d.get("threads",[]): ts.setdefault(t["id"],(t.get("name",""),"archived"))
    if not d.get("has_more") or not d.get("threads"): break
    before=d["threads"][-1]["thread_metadata"]["archive_timestamp"]
g=json.load(open(acc)).get("groups",{})
if ch in g: print("ERR channel %s already has a row in %s: %s" % (ch,acc,g[ch].get("note","")[:80])); sys.exit(0)
print("NAME", c.get("name",""))
for k,(n,s) in ts.items(): print("KEEP" if k in g else "DENY", k, s, n)
PYT
)
    [[ $threads = ERR* ]] && { echo "stop: ${threads#ERR }"; exit 1; }
    chname=$(print -r -- $threads | sed -n 's/^NAME //p')
    deny=(${(f)"$(print -r -- $threads | awk '$1=="DENY"{print $2}')"}); [[ -z ${deny[1]:-} ]] && deny=()
    echo "plan: link $W -> $BOT by forward on the WHOLE channel #$chname ($CH), no thread opened"
    echo "  1. back up $ACC, add groups[$CH] = {requireMention: false, forwardTo: $W, wholeChannel: true,"
    echo "       answerCmd: \"$ANS\", allowFrom: [Nat, catbutter]}"
    echo "  2. threads of the channel (they fall back to the channel row unless they have their own):"
    print -r -- $threads | awk '$1=="DENY"{$1="";print "       deny  "$0" -> {deny: true, linkedBy: wt}"} $1=="KEEP"{$1="";print "       keep  "$0" (already has a row)"}'
    (( ${#deny} )) || echo "       (none to deny)"
    echo "  3. split $BPANE ($BOT body), start claude in $W with env -u DISCORD_BOT_TOKEN -u DISCORD_STATE_DIR (an agent already in $W is reused)"
    echo "  4. test: Nat types a line in #$chname; the $BOT body forwards it to that pane, which answers with answerCmd"
    echo "     a thread opened later has no row and also forwards: deny it by hand if it is not for $W"
    (( run )) || { echo "plan only. To run (Nat's go): herdr-soul link $W --bot=$BOT --whole-channel=$CH --yes"; exit 0; }
    cp -p $ACC $ACC.bak-$(date +%Y%m%d-%H%M%S)-link
    python3 -c 'import json,sys
f,ch,w,ans,name,*deny=sys.argv[1:]; a=json.load(open(f)); g=a.setdefault("groups",{})
g[ch]={"requireMention":False,"forwardTo":w,"wholeChannel":True,"answerCmd":ans,
 "allowFrom":["691531480689541170","917019242094817301"],"note":"link: whole channel #%s forwards to worktree %s (herdr-soul link --whole-channel)" % (name,w)}
for t in deny:
    if t not in g: g[t]={"deny":True,"linkedBy":w,"note":"thread of #%s kept out of the whole-channel forward to %s" % (name,w)}
json.dump(a,open(f,"w"),indent=2,ensure_ascii=False)' $ACC $CH $W $ANS $chname $deny
    echo "  ✓ row $CH + ${#deny} deny rows in $ACC (backup beside it)"
    TH=$CH
  else
  echo "plan: link $W -> $BOT by forward (no second gateway)"
  echo "  1. as $BOT: post '🔗 $NAME' in channel $CH, open thread '$NAME' on it ($SAY --thread)"
