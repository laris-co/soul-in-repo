json.dump(a,open(f,"w"),indent=2,ensure_ascii=False)' $ACC $TH $W $ANS $NAME
  echo "  ✓ row $TH in $ACC (backup beside it)"
  fi
  # an agent already living in the worktree is reused: a second one there would make the forward target ambiguous
  NP=$(herdr agent list 2>/dev/null | python3 -c 'import json,sys
w=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]
print(next((x["pane_id"] for x in a if x.get("cwd")==w and x.get("agent")),""))' $W)
  if [[ -n $NP ]]; then echo "  ✓ agent already in $W ($NP): reused, no new pane"
  else
