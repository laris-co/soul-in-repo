#!/usr/bin/env python3
"""wake-card-retire <cwd> — move every herdr-sleep wake card of <cwd> to the attic (laris-team issue #237).

A soul taken out (herdr-soul out --go) or a closed named worktree (herdr-soul wt-close --yes) must not stay a
💤 sleeper in /ls: its card, ~/.local/state/herdr-sleep/<date>/<label>.json, moves to
~/.local/state/herdr-sleep/attic/<today>_<label>/ (depth 3, outside the */*.json glob that space-sleep.sh list reads).
Nothing is deleted: a name clash keeps both (the source date becomes a prefix). Any herdr session.
Same rule as laris-team tools/space-sleep.sh retire; kept here so soul-in-repo needs no laris-team checkout.
HERDR_SLEEP_STATE overrides the state dir (tests). Prints "card moved: <from> -> <to>" per card, or "no wake card for <cwd>".
"""
import glob, json, os, sys, time


def label(cwd):   # <repo>--<wt name> or <repo>: the card's file name, as space-sleep.sh writes it
    if "/wt/" in cwd:
        head, tail = cwd.split("/wt/", 1)
        return os.path.basename(head) + "--" + os.path.basename(tail)
    return os.path.basename(cwd)


def main(argv):
    if len(argv) != 1 or not argv[0].startswith("/"):
        print(__doc__); return 2
    cwd = argv[0].rstrip("/")
    st = os.environ.get("HERDR_SLEEP_STATE") or os.path.expanduser("~/.local/state/herdr-sleep")
    dest = os.path.join(st, "attic", time.strftime("%Y-%m-%d") + "_" + label(cwd))
    n = 0
    for f in sorted(glob.glob(os.path.join(st, "*", "*.json"))):
        try: d = json.load(open(f))
        except Exception: continue
        if (d.get("space", {}).get("cwd") or "").rstrip("/") != cwd: continue
        os.makedirs(dest, exist_ok=True)
        to = os.path.join(dest, os.path.basename(f))
        if os.path.exists(to): to = os.path.join(dest, os.path.basename(os.path.dirname(f)) + "_" + os.path.basename(f))
        os.rename(f, to); n += 1
        print("card moved: " + f + " -> " + to)
    if not n: print("no wake card for " + cwd)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
